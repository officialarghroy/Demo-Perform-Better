# --- Supabase --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key — secret, server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Vapi AI receptionist ---------------------------------------------
# Shared secret configured on the Vapi assistant's Server URL credential.
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
# Optional: only needed if you call the Vapi API from this server.
VAPI_API_KEY=your-vapi-api-key

# --- Internal admin tooling --------------------------------------------
# Shared secret required to update a referral's status (x-admin-secret header).
ADMIN_API_SECRET=your-admin-api-secret
